# Copy to .env for local runs. All keys are prefixed VEC_ (see app/config.py).

# --- Deployment environment ---
# "local" (the default) lets the development credentials below stand, so a fresh checkout runs with
# no setup. Set to "staging"/"production" on a real deployment: startup then REFUSES to continue if
# VEC_PG_DSN, VEC_INTERNAL_SERVICE_TOKEN or storage/model keys still use a shipped local value. The failure
# being prevented is a deploy that forgets to override one and starts anyway on a public default.
VEC_ENVIRONMENT=local

# --- Shared business PostgreSQL; restricted rag role, derived tables in schema rag ---
VEC_PG_DSN=postgresql://rag:rag123@localhost:5432/pocdb
VEC_PG_POOL_MIN_SIZE=1
VEC_PG_POOL_MAX_SIZE=8

# Structured facts are read from jira-backend's source database through its private API.
VEC_JIRA_BACKEND_URL=http://localhost:8081
# Must match INTERNAL_SERVICE_TOKEN on jira-backend.
VEC_INTERNAL_SERVICE_TOKEN=dev-internal-service-token-min-32-chars-long!!

# --- Kafka ---
VEC_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- OpenSearch (lexical retrieval / BM25) ---
# The keyword-matching half of hybrid search. Without it, mode=bm25 and mode=hybrid fail;
# mode=vector still works. GET /healthz reports index_drift (Postgres chunk count minus indexed
# count) — anything non-zero means POST /search/reindex is due.
# On AWS this points at an Amazon OpenSearch Service domain endpoint instead of localhost.
VEC_OPENSEARCH_URL=http://localhost:9200
VEC_OPENSEARCH_CHUNK_INDEX=orchestra-chunks
VEC_KAFKA_CONTENT_TOPIC=jira.content.ingestion
VEC_KAFKA_ATTACHMENT_TOPIC=jira.attachment.ingestion
VEC_KAFKA_GROUP_ID=vectorization-service
VEC_KAFKA_AUTO_OFFSET_RESET=earliest
VEC_KAFKA_CONSUME_ATTACHMENTS=false

# --- Embeddings ---
# Provider: openai (any OpenAI-compatible server) | fake (no key, deterministic vectors)
# Default here: openai, pointed at the LiteLLM gateway (:4000) — VEC_EMBEDDING_MODEL is the gateway
# route ALIAS `openai-embedding-3-small` (-> OpenAI text-embedding-3-small, 1536 dims truncated to
# 1024), VEC_OPENAI_API_KEY is this service's LiteLLM virtual key (scripts/litellm_provision_keys.sh).
VEC_EMBEDDING_PROVIDER=openai
VEC_EMBEDDING_MODEL=openai-embedding-3-small
VEC_EMBEDDING_DIM=1024
VEC_EMBEDDING_TRUNCATE_DIM=1024
VEC_OPENAI_API_KEY=sk-vec-service-local
VEC_OPENAI_BASE_URL=http://localhost:4000
VEC_EMBEDDING_BATCH_SIZE=64
VEC_EMBEDDING_MAX_RETRIES=3

# --- Chunking ---
VEC_CHUNK_SIZE_TOKENS=800
VEC_CHUNK_OVERLAP_TOKENS=130
# "structural" cuts at heading/paragraph/line/sentence boundaries and prepends the heading path to
# each chunk; "token" is the original blind fixed-window splitter, kept as a rollback switch.
VEC_CHUNK_STRATEGY=structural

# --- Per-document index status tracking (GET /ingestion/health, POST /ingestion/status) ---
# Records which pipeline stage each source reached, so "this attachment isn't in search" is
# answerable instead of ambiguous. Costs a few small keyed UPDATEs per document.
VEC_INGESTION_STATUS_ENABLED=true

# --- Optional contextual retrieval (one LLM call per chunk; off by default) ---
# When on, via the LiteLLM gateway: route alias `claude-context` -> claude-haiku-4-5.
VEC_CONTEXTUAL_RETRIEVAL_ENABLED=false
VEC_CONTEXTUAL_LLM_PROVIDER=openai_compatible
VEC_CONTEXTUAL_ANTHROPIC_API_KEY=
VEC_CONTEXTUAL_ANTHROPIC_MODEL=claude-haiku-4-5
VEC_CONTEXTUAL_OPENAI_BASE_URL=http://localhost:4000
VEC_CONTEXTUAL_OPENAI_API_KEY=sk-vec-service-local
VEC_CONTEXTUAL_OPENAI_MODEL=claude-context

# --- Object storage (MinIO locally) — only needed if VEC_KAFKA_CONSUME_ATTACHMENTS=true ---
VEC_S3_ENDPOINT=http://localhost:9000
VEC_S3_ACCESS_KEY=minioadmin
VEC_S3_SECRET_KEY=minioadmin
VEC_S3_REGION=us-east-1

# --- Attachment parsing ---
VEC_DOCLING_DO_OCR=false
VEC_DOCLING_DO_TABLE_STRUCTURE=false
VEC_ATTACHMENT_MAX_BYTES=26214400
VEC_OCR_MIN_CONFIDENCE=0.4
# OCR engine for the PDF path only (standalone images always use EasyOCR directly): default | easyocr | rapidocr | tesseract.
VEC_DOCLING_OCR_ENGINE=easyocr
# fast | accurate. Measured as making no difference on this project's DocVQA fixture; kept configurable.
VEC_DOCLING_TABLE_MODE=fast
# Matryoshka (MRL) truncation of a larger embedding model's native output down to VEC_EMBEDDING_DIM.
# Leave unset unless the model was actually MRL-trained (text-embedding-3, Nomic, ...) —
# truncating an ordinary embedding destroys it. pgvector's HNSW/IVFFlat index caps at 2000 dims (4000
# for halfvec) regardless of pgvector version, which is when this is needed.
# VEC_EMBEDDING_TRUNCATE_DIM=

# --- VLM fallback for images EasyOCR struggled with (app/ingest/vlm_describer.py) ---
# Off by default — a real per-escalated-image LLM call; see README "Chunking & attachment handling".
# When on, via the LiteLLM gateway: route alias `gemini-vlm` -> gemini-3.8-flash (chosen over
# gpt-5.6-luna, which truncates dense pages; see the route's comment in litellm-gateway/config.yaml).
VEC_VLM_OCR_ENABLED=false
VEC_VLM_PROVIDER=openai_compatible
VEC_VLM_ANTHROPIC_API_KEY=
VEC_VLM_ANTHROPIC_MODEL=claude-opus-4-8
VEC_VLM_OPENAI_BASE_URL=http://localhost:4000
VEC_VLM_OPENAI_MODEL=gemini-vlm
VEC_VLM_OPENAI_API_KEY=sk-vec-service-local
# Reject a suspiciously short VLM replacement when dense OCR already recovered much more text.
VEC_VLM_MIN_OCR_COVERAGE_RATIO=0.5
# Parse scanned/image-heavy PDF pages with the VLM. Docling remains the first parser; only scan-like
# (condition A: under VEC_VLM_PDF_MIN_TEXT_CHARS of embedded text) or visual (condition B) pages are
# rendered, up to the cap. ON by default — see app/config.py for the measurements, including why the
# earlier revert of this flag turned out to have measured the VLM rather than the escalation, and why
# a narrower "only escalate hard-looking pages" router scored WORSE than escalating everything.
# Set to false to skip the per-page VLM cost; the three evidence-gated detectors below still run.
VEC_VLM_PDF_ENABLED=true
VEC_VLM_PDF_RENDER_DPI=200
VEC_VLM_PDF_MAX_PAGES=15
VEC_VLM_PDF_MIN_TEXT_CHARS=80
VEC_VLM_PDF_INCLUDE_VISUAL_PAGES=true
# 500 can truncate dense tables; 2000 is a safer production default for a selected PDF page.
VEC_VLM_MAX_COMPLETION_TOKENS=2000
# Reasoning effort for a reasoning-capable hosted VLM (e.g. gpt-5.6-luna). "low" leaves enough of the
# completion budget for visible table content; "none" starves table extraction of reasoning it needs.
VEC_VLM_REASONING_EFFORT=low
# Attachments indexed with OCR text because the VLM call failed are queued and re-ingested once the
# VLM answers (app/ingest/vlm_retry.py). The first retry waits this long, then doubles per attempt.
VEC_VLM_RETRY_ENABLED=true
VEC_VLM_RETRY_INTERVAL_SECONDS=600
VEC_VLM_RETRY_MAX_ATTEMPTS=8
# Escalate to VLM when a PDF page's own OCR cells report low per-cell confidence over this fraction of
# the page (see vlm_pdf_low_confidence_page_ratio in app/config.py for the measurement behind 0.15).
VEC_VLM_PDF_OCR_CONFIDENCE_DETECTION_ENABLED=true
VEC_VLM_PDF_LOW_CONFIDENCE_PAGE_RATIO=0.15
# Escalate a standalone image to VLM when EasyOCR's bounding boxes show column/table geometry that flat
# text would destroy, independent of OCR confidence (see docling_parser._column_row_ratio).
VEC_VLM_IMAGE_COLUMN_DETECTION_ENABLED=true
VEC_VLM_IMAGE_COLUMN_ROW_RATIO=0.15
# Escalate a PDF page whose Docling table output shows an orphaned all-parenthetical cell (a cell
# whose first line Docling dropped), independent of vlm_pdf_enabled.
VEC_VLM_PDF_TABLE_DEFECT_DETECTION_ENABLED=true

# --- Reranking (second-stage cross-encoder over the fused hybrid candidate pool) ---
# On by default; see README "Reranking" section for measured latency.
VEC_RERANK_ENABLED=true
VEC_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VEC_RERANK_CANDIDATE_POOL=20
# Minimum cross-encoder score to keep a hit (unset = no filtering, rerank only reorders/truncates).
# ms-marco-MiniLM-L-6-v2 scores are unbounded logits, not 0-1 cosine — tune against your own data.
# Leave this line commented out to actually get "unset": pydantic-settings tries to parse an empty
# string as a float for a non-str Optional field rather than treating "" as absent, so
# `VEC_RERANK_SCORE_THRESHOLD=` (present but blank) fails Settings validation at startup instead of
# quietly meaning "no threshold." Uncomment and give it a real number if you want to set one.
# VEC_RERANK_SCORE_THRESHOLD=

# --- Distributed tracing (app/tracing.py) ---
# Needs the Phoenix container (docker compose -f observability/docker-compose.observability.yml up).
# When on, this service both extracts the W3C `traceparent` ai-service injects AND injects its own
# into the httpx calls it makes to the litellm gateway, so its per-stage spans (search.embed /
# search.retrieval / search.rerank) and the gateway's embedding spans all appear as children of the
# /ask span that caused them — one waterfall across three processes. Set true alongside
# AI_PHOENIX_ENABLED=true. (OTLP/gRPC on 4317, same collector ai-service uses.)
VEC_TRACING_ENABLED=false
VEC_TRACING_COLLECTOR_ENDPOINT=http://localhost:4317
# Overrides the `service.name` resource attribute; blank uses this service's own name.
VEC_TRACING_SERVICE_NAME=

# --- Logging ---
VEC_LOG_LEVEL=INFO
VEC_LOG_JSON=true
