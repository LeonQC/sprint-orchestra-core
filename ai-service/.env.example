# --- Deployment environment ---
# "local" (the default) lets every development credential in app/config.py stand, so a fresh
# checkout runs with no setup. Set this to "staging"/"production" on a real deployment: startup then
# REFUSES to continue if any of AI_INTERNAL_SERVICE_TOKEN, AI_EPIC_ROLLOUT_CHECKPOINT_DB_URL,
# AI_SPRINT_RECOVERY_CHECKPOINT_DB_URL or AI_OPENAI_API_KEY is still the shipped local value. That check exists because
# the dangerous failure is not the defaults being in the repo (they secure nothing but a laptop) —
# it is a deploy that forgets to override one and starts anyway, using a value published on GitHub.
AI_ENVIRONMENT=local

# --- Downstream ---
AI_VECTORIZATION_SERVICE_URL=http://localhost:8100

# --- LLM: through the LiteLLM gateway (:4000) ---
# Default: openai_compatible pointed at the gateway. AI_AGENT_MODEL is a gateway route ALIAS
# (litellm-gateway/config.yaml), not a raw model id — the gateway maps openai-production ->
# gpt-5.6-luna (or claude-production -> claude-sonnet-5). AI_OPENAI_API_KEY is this service's litellm
# virtual key (scripts/litellm_provision_keys.sh); the real provider keys live in the root ./.env.
#
# To bypass the gateway, set AI_LLM_PROVIDER=anthropic + AI_AGENT_MODEL=claude-sonnet-5 +
# AI_ANTHROPIC_API_KEY=... to use the native anthropic SDK directly.
AI_LLM_PROVIDER=openai_compatible
AI_AGENT_MODEL=openai-production
AI_OPENAI_BASE_URL=http://localhost:4000
AI_OPENAI_API_KEY=sk-ai-service-local
AI_ANTHROPIC_API_KEY=

# "inherit" runs the cheap capability-routing call on the same client (the gateway): ~$0.0003 per
# call at gpt-5.6-luna pricing. To split it onto a separate model behind the gateway instead:
AI_ROUTER_LLM_PROVIDER=inherit
# AI_ROUTER_LLM_PROVIDER=openai_compatible
# AI_ROUTER_MODEL=<gateway route alias>
# AI_ROUTER_OPENAI_BASE_URL=http://localhost:4000
# AI_ROUTER_OPENAI_API_KEY=sk-ai-service-local
# AI_ROUTER_MAX_OUTPUT_TOKENS=128
# AI_ROUTER_REQUEST_TIMEOUT_SECONDS=30
# AI_ROUTER_REASONING_EFFORT=none

# --- Agent loop ---
AI_MAX_TOOL_ITERATIONS=4
AI_RETRIEVAL_TOP_K=5
AI_MAX_OUTPUT_TOKENS=2048
# HTTP timeout for the openai_compatible provider only — a long reasoning generation can take over
# a minute; bump this rather than the model catching a spurious ReadTimeout mid-generation.
AI_LLM_REQUEST_TIMEOUT_SECONDS=300

# Optional extra live-answer verifier; costs one additional LLM call for non-abstaining answers.
AI_FAITHFULNESS_CHECK_ENABLED=false

# Optional planner <-> critic LangGraph generation path. Durable rollout below works with either
# planning implementation.
AI_EPIC_PLANNING_MULTIAGENT_ENABLED=false

# --- Shared Redis semantic answer cache (Redis Stack / RediSearch) ---
AI_CACHE_ENABLED=true
AI_REDIS_URL=redis://localhost:6379/0
AI_CACHE_TTL_SECONDS=600
AI_CACHE_SIMILARITY_THRESHOLD=0.97
AI_CACHE_MAX_ENTRIES=500
# Must match VEC_EMBEDDING_DIM.
AI_CACHE_EMBEDDING_DIM=1024
# In-process memo window for the index freshness token (vectorization-service GET /index/watermark),
# which is what lets a cached answer be reused at all. 0 = check on every lookup. Raising it trades
# exactly that many seconds of possible staleness for skipping one cheap indexed query per /ask.
AI_CACHE_WATERMARK_TTL_SECONDS=0
# Ask AI's LLM calls opt in to LiteLLM's exact-match response cache (litellm-gateway/config.yaml).
# Set false for eval runs that measure run-to-run variance.
AI_LLM_RESPONSE_CACHE_ENABLED=true

# --- Request authentication: a user JWT, or the internal service token ---
# Public keys for verifying user JWTs; point both at Cognito/Auth0 to trust that issuer instead.
AI_JWT_JWKS_URL=http://localhost:8081/.well-known/jwks.json
AI_JWT_ISSUER=jira-agentic-ai
# Must match jira-backend's INTERNAL_SERVICE_TOKEN (service calls and feedback receipts).
AI_INTERNAL_SERVICE_TOKEN=dev-internal-service-token-min-32-chars-long!!

# --- Per-user AI limits (app/auth/user_quota.py), counted in Redis at AI_REDIS_URL ---
# Only for signed-in users, only on endpoints that start new AI work.
AI_USER_QUOTA_ENABLED=true
AI_USER_QUOTA_REQUESTS_PER_MINUTE=20
AI_USER_QUOTA_DAILY_BUDGET_USD=2.0

# --- Space authorization ---
AI_SPACE_MEMBERSHIP_CHECK_ENABLED=true
AI_JIRA_BACKEND_URL=http://localhost:8081
AI_SPACE_MEMBERSHIP_CACHE_TTL_SECONDS=60

# --- MCP server for external agents (POST /mcp; public path /api/ai/mcp) ---
# Tool scope comes from the caller's memberships, so MCP refuses every call when
# AI_SPACE_MEMBERSHIP_CHECK_ENABLED=false.
AI_MCP_ENABLED=true

# --- Durable LangGraph workflows (checkpointed in core Postgres) ---
AI_EPIC_ROLLOUT_ENABLED=true
AI_EPIC_ROLLOUT_CHECKPOINT_DB_URL=postgresql://poc:poc123@localhost:5432/pocdb

AI_SPRINT_RECOVERY_ENABLED=true
# When both workflows are enabled, the two checkpoint DSNs must match because they share a saver.
AI_SPRINT_RECOVERY_CHECKPOINT_DB_URL=postgresql://poc:poc123@localhost:5432/pocdb
AI_SPRINT_RECOVERY_MAX_CLARIFICATION_ROUNDS=2
AI_SPRINT_RECOVERY_MAX_ESCALATION_ROUNDS=2
AI_SPRINT_RECOVERY_MAX_PLAN_REVISION_ROUNDS=2
AI_SPRINT_RECOVERY_MAX_TOKEN_BUDGET=200000
# Optional Slack-compatible incoming webhook; unset means warning logs only.
# AI_SPRINT_RECOVERY_ESCALATION_WEBHOOK_URL=

# --- Logging ---
AI_LOG_LEVEL=INFO
AI_LOG_JSON=true

# --- Observability: Phoenix tracing (trace-level view of LLM calls; complements the
# Prometheus/Grafana metrics in app/observability.py — see app/tracing.py for exact coverage) ---
# Off by default: needs the Phoenix container running
# (docker compose -f observability/docker-compose.observability.yml up -d) to have somewhere to send
# spans to.
AI_PHOENIX_ENABLED=false
AI_PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
AI_PHOENIX_PROJECT_NAME=sprint-orchestra-ai-service
# Where traces are read back OUT (HTTP), as opposed to sent IN (OTLP gRPC, above). Used only by
# `python -m scripts.push_prompt_to_phoenix`. The service itself never calls this.
AI_PHOENIX_BASE_URL=http://localhost:6006

# --- Optional second trace backend: Langfuse Cloud (free Hobby plan) ---
# Additive, not a swap. With both on, one instrumentation feeds two backends: Phoenix for trace
# debugging and evals, Langfuse for the per-user / per-feature cost dashboard that Phoenix's span
# table cannot aggregate. See app/tracing.py for the one token-accounting incompatibility that
# matters (and why nothing here trips over it).
# Keys: Langfuse project -> Settings -> API Keys. EU region is https://cloud.langfuse.com.
AI_LANGFUSE_ENABLED=false
AI_LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
AI_LANGFUSE_PUBLIC_KEY=
AI_LANGFUSE_SECRET_KEY=
